# Copy this file to .env in the project root.
# Local MongoDB option:
MONGODB_URI=mongodb://127.0.0.1:27017/interviewAI

# Optional for Gemini-powered questions/evaluation. Get a free key from Google AI Studio.
# If missing or quota-exhausted, built-in questions and a clearly labelled local fallback evaluation are used.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
